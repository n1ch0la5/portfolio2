# Netlify Blobs access for `npm run resumes` (copy to .env.local, which is gitignored).
# Token:   https://app.netlify.com/user/applications#personal-access-tokens
# Site ID: Netlify > nicksjohnson.com > Project configuration > General > Project details (Project ID)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Optional
# RESUME_RETENTION_MONTHS=3
# RESUME_DOWNLOADS_DIR=/Users/nick/Downloads
# SITE_URL=https://nicksjohnson.com
